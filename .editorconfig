# top-most EditorConfig file
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = tab
indent_size = 4
quote_type = single
tab_width = 4

# iCalendar files are CRLF-terminated and their leading white space is
# significant: it is what a fold inserts.
[test/harness/fixtures/ics/*.ics]
end_of_line = crlf
indent_style = space
trim_trailing_whitespace = false
