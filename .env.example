# Credentials for live verification runs against real CalDAV servers.
# Copy this file to .env, fill in what you have, and source it:
#
#     set -a; . ./.env; set +a
#
# .env is gitignored. This template is committed, so it must never carry a
# real value.
#
# Each provider takes three variables. A provider missing any of its three
# is skipped by the run rather than failing it, so an empty file is a
# valid file — fill in only the providers you are verifying. Everything
# else about the scheme is in test/live/README.md.

# Apple. The secret is an app-specific password from appleid.apple.com,
# not the account password.
DAVENPORT_TEST_ICLOUD_URL=https://caldav.icloud.com/
DAVENPORT_TEST_ICLOUD_USERNAME=you@example.com
DAVENPORT_TEST_ICLOUD_SECRET=xxxx-xxxx-xxxx-xxxx

# Fastmail. The secret is an app password with calendar access.
DAVENPORT_TEST_FASTMAIL_URL=https://caldav.fastmail.com/dav/
DAVENPORT_TEST_FASTMAIL_USERNAME=you@fastmail.com
DAVENPORT_TEST_FASTMAIL_SECRET=app-password

# Nextcloud, as test/live/docker-compose.yml brings it up. Point the three
# at a hosted instance instead to verify against that; there the secret is
# an app password from Settings, Security.
DAVENPORT_TEST_NEXTCLOUD_URL=http://localhost:8802/remote.php/dav/
DAVENPORT_TEST_NEXTCLOUD_USERNAME=davenport
DAVENPORT_TEST_NEXTCLOUD_SECRET=davenport

# Radicale, as test/live/docker-compose.yml brings it up. These values are
# the throwaway credentials baked into that file; point them somewhere
# else to verify against your own instance.
DAVENPORT_TEST_RADICALE_URL=http://localhost:5232/
DAVENPORT_TEST_RADICALE_USERNAME=davenport
DAVENPORT_TEST_RADICALE_SECRET=davenport

# Baikal, as test/live/docker-compose.yml brings it up.
DAVENPORT_TEST_BAIKAL_URL=http://localhost:8801/dav.php/
DAVENPORT_TEST_BAIKAL_USERNAME=davenport
DAVENPORT_TEST_BAIKAL_SECRET=davenport

# Google, over the CalDAV v2 endpoint. Google authenticates with OAuth, so
# the secret is a refresh token for an account that has granted the
# calendar scope; which client the token belongs to is settled by the
# Google verification work.
DAVENPORT_TEST_GOOGLE_URL=https://apidata.googleusercontent.com/caldav/v2/
DAVENPORT_TEST_GOOGLE_USERNAME=you@gmail.com
DAVENPORT_TEST_GOOGLE_SECRET=oauth-refresh-token
