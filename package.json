{
	"name": "davenport",
	"version": "0.0.1",
	"author": "ren (lathrys-at)",
	"description": "Sync calendar events and tasks between your vault and CalDAV servers (iCloud, Fastmail, Nextcloud, Google, and more).",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"probe:build": "tsc -noEmit -skipLibCheck && node tools/frontmatter-probe/build.mjs",
		"timezone:download": "node tools/timezone-table/download.mjs",
		"timezone:generate": "node tools/timezone-table/generate.mjs",
		"vault": "node scripts/vault.mjs",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"coverage": "vitest run --coverage",
		"mutation": "stryker run",
		"fuzz": "node scripts/fuzz-ics.mjs",
		"lint": "eslint . --max-warnings=0",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"markdown:check": "node scripts/markdown-shape.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"engines": {
		"node": ">=24"
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@stryker-mutator/core": "10.0.0",
		"@stryker-mutator/vitest-runner": "10.0.0",
		"@types/node": "^26.6.5",
		"@vitest/coverage-v8": "^5.0.3",
		"@vitest/utils": "5.0.3",
		"@xmldom/xmldom": "^0.9.12",
		"esbuild": "0.28.2",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"fast-check": "4.10.2",
		"globals": "^17.13.0",
		"jiti": "^2.6.1",
		"obsidian": "1.14.4",
		"prettier": "^3.9.10",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.71.1",
		"vitest": "^5.0.3",
		"yaml": "^2.9.1"
	},
	"overrides": {
		"typed-rest-client": {
			"qs": "6.15.2"
		}
	},
	"dependencies": {
		"ical.js": "2.2.1",
		"tsdav": "2.4.0"
	}
}
