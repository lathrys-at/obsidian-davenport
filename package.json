{
	"name": "davenport",
	"version": "0.0.1",
	"description": "Sync calendar events and tasks between your vault and CalDAV servers (iCloud, Fastmail, Nextcloud, Google, and more).",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"probe:build": "tsc -noEmit -skipLibCheck && node tools/frontmatter-probe/build.mjs",
		"vault": "node scripts/vault.mjs",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"coverage": "vitest run --coverage",
		"mutation": "stryker run",
		"lint": "eslint . --max-warnings=0",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"engines": {
		"node": ">=24"
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@stryker-mutator/core": "10.0.0",
		"@stryker-mutator/vitest-runner": "10.0.0",
		"@types/node": "^24.13.3",
		"@vitest/coverage-v8": "^4.1.10",
		"@vitest/utils": "4.1.10",
		"@xmldom/xmldom": "^0.9.10",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"fast-check": "^4.9.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "1.12.3",
		"prettier": "^3.9.6",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^4.1.10",
		"yaml": "^2.9.0"
	},
	"overrides": {
		"typed-rest-client": {
			"qs": "6.15.2"
		}
	},
	"dependencies": {
		"ical.js": "2.2.1"
	}
}
