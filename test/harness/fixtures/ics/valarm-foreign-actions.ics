BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//Davenport//Adversarial ICS corpus//EN
BEGIN:VEVENT
UID:valarm-foreign-actions@corpus.davenport.test
DTSTAMP:20260101T000000Z
DTSTART:20260308T163000Z
DTEND:20260308T173000Z
SUMMARY:Alarms written by some other client
BEGIN:VALARM
ACTION:AUDIO
TRIGGER:-PT10M
ATTACH;FMTTYPE=audio/basic:ftp://example.test/sounds/bell-01.aud
END:VALARM
BEGIN:VALARM
ACTION:DISPLAY
DESCRIPTION:A display alarm that repeats
TRIGGER:-PT30M
DURATION:PT5M
REPEAT:4
END:VALARM
BEGIN:VALARM
ACTION:EMAIL
SUMMARY:Reminder from another client
DESCRIPTION:The body of the reminder mail\nsplit over two lines
ATTENDEE:mailto:someone@example.test
ATTENDEE:mailto:another@example.test
TRIGGER;RELATED=END:-P1D
END:VALARM
END:VEVENT
END:VCALENDAR
