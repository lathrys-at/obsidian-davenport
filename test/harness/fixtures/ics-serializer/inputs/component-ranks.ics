BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//Davenport//golden inputs//EN
BEGIN:X-VENDOR-BLOCK
X-VENDOR-KEY:beside the calendar
END:X-VENDOR-BLOCK
BEGIN:VJOURNAL
UID:journal-series
RECURRENCE-ID:20260309T090000Z
DTSTART:20260309T090000Z
SUMMARY:the override of the journal entry
END:VJOURNAL
BEGIN:VTODO
UID:todo-series
RECURRENCE-ID:20260309T090000Z
DUE:20260309T090000Z
SUMMARY:the override of the task
END:VTODO
BEGIN:VEVENT
UID:event-series
RECURRENCE-ID:20260309T090000Z
DTSTART:20260309T090000Z
SUMMARY:the override of the event
END:VEVENT
BEGIN:VJOURNAL
UID:journal-series
DTSTART:20260302T090000Z
RRULE:FREQ=WEEKLY
SUMMARY:the master of the journal entry
END:VJOURNAL
BEGIN:VTODO
UID:todo-series
DUE:20260302T090000Z
RRULE:FREQ=WEEKLY
SUMMARY:the master of the task
BEGIN:X-VENDOR-TASK-EXTRA
X-VENDOR-KEY:inside the task
END:X-VENDOR-TASK-EXTRA
BEGIN:VALARM
ACTION:DISPLAY
DESCRIPTION:the alarm of the task
TRIGGER:-PT15M
END:VALARM
END:VTODO
BEGIN:VEVENT
UID:event-series
DTSTART:20260302T090000Z
RRULE:FREQ=WEEKLY
SUMMARY:the master of the event
END:VEVENT
BEGIN:VTIMEZONE
TZID:America/New_York
BEGIN:X-VENDOR-ZONE-EXTRA
X-VENDOR-KEY:inside the timezone definition
END:X-VENDOR-ZONE-EXTRA
BEGIN:DAYLIGHT
DTSTART:20070311T020000
RRULE:FREQ=YEARLY;BYMONTH=3;BYDAY=2SU
TZNAME:EDT
TZOFFSETFROM:-0500
TZOFFSETTO:-0400
END:DAYLIGHT
BEGIN:STANDARD
DTSTART:20071104T020000
RRULE:FREQ=YEARLY;BYMONTH=11;BYDAY=1SU
TZNAME:EST
TZOFFSETFROM:-0400
TZOFFSETTO:-0500
END:STANDARD
END:VTIMEZONE
END:VCALENDAR
