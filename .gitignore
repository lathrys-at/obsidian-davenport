# vscode
.vscode 

# Intellij
*.iml
.idea

# npm
node_modules

# test coverage output
coverage/

# The mutation run writes the reports of the run into this directory. A
# person reads the HTML report.
reports/

# The mutation run copies the repository into this directory, and it makes
# each mutant in the copy. The run removes the directory when the run ends.
.stryker-tmp/

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js

# The build writes this record of the bundle. The record says which module
# holds which bytes of the output, and a person reads it.
bundle-meta.json

# Exclude sourcemaps
*.map

# The build output of a kit under tools/, assembled for copying into a
# vault. The pattern names no kit, so a renamed kit stays ignored, and the
# build output of an earlier name stays ignored too.
tools/*/dist/

# obsidian
data.json

# Scratch vaults the QA vault script makes. Disposable by design: each one
# holds a built copy of the probe and whatever a run of it wrote.
.vaults/

# Live verification credentials. .env.example is the committed template.
.env
.env.*
!.env.example

# Exclude macOS Finder (System Explorer) View States
.DS_Store

# agent worktrees and session config
.claude/
